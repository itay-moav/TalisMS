{
	"name": "director-moav/talis-ms",
	"description": "TalisMS Is an API framework /  middleware styled framework with multiple Door(r) types to invoke it",
	"type": "git",
	"keywords": [
		"TalisMS",
		"php",
		"middleware"
	],
	"require": {
		"php": ">=8.5"
	},
	"autoload": {
		"psr-4": {
			"Talis\\": "src/Talis/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Talis\\Tests\\": "tests/"
		}
	},
	"authors": [
		{
			"name": "Itay Moav",
			"homepage": "https://cookinginbinary.blog",
			"role": "Superman"
		}
	],
	"support": {
		"issues": "https://github.com/itay-moav/TalisMS/issues"
	},
	"require-dev": {
		"phpunit/phpunit": "^13",
		"phpstan/phpstan": "^2",
		"phpstan/phpstan-phpunit": "^2"
	},
	"scripts": {
		"test": "phpunit",
		"stan": "phpstan analyse",
		"coverage": [
			"@php -d pcov.enabled=1 vendor/bin/phpunit --coverage-clover var/coverage/clover.xml --coverage-text",
			"@php bin/check-coverage.php var/coverage/clover.xml 100"
		]
	}
}
